# Buildroot defconfig for the wash RISC-V demo rootfs.
#
# - rv64gc (matches Bellard's bbl64.bin / TinyEMU emulated ISA)
# - musl libc (smaller than glibc)
# - external prebuilt bootlin toolchain (skips ~25 min of gcc build)
# - busybox init (no openrc/systemd weight)
# - ext2 rootfs ~8 MiB (TinyEMU virtio-blk reads it directly)
# - no kernel here; image-rv/kernel/ owns kernel build.
#
# Iterate with `make -C image-rv menuconfig` inside the builder if you
# want to tweak. Save back to this file via `make savedefconfig
# BR2_DEFCONFIG=…/wash_riscv64_defconfig` from inside the buildroot tree.

BR2_riscv=y
BR2_RISCV_64=y
BR2_RISCV_ABI_LP64D=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ISA_RVC=y

# Prebuilt riscv64 musl toolchain from bootlin. Saves ~25 min cold build.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_RISCV64_LP64D_MUSL_STABLE=y

BR2_OPTIMIZE_S=y

# Init = busybox. Boot ordering via /etc/init.d/SNNxxx scripts.
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="/input/busybox.fragment"
BR2_PACKAGE_NANO=y

# Userspace entropy daemon. TinyEMU/RISC-V has no hardware RNG and
# the kernel's CRYPTO_JITTERENTROPY refuses to initialize on the
# emulated CPU (insufficient timing variance). Without an entropy
# source every crypto/rand consumer in Go (attach token mint, priv
# handshake, anything calling getrandom(2)) blocks for 60+ seconds
# on first use, which wedges the spawn pipeline before priv can
# even reply to a PrepareSpawn. haveged installs an S20haveged
# init script that starts before wash-router (S99), seeds the pool
# via the HAVEGE algorithm (userspace CPU-flutter extraction —
# works where kernel jitter entropy doesn't), and keeps it topped
# up. All wash code paths then assume crypto/rand "just works."
BR2_PACKAGE_HAVEGED=y

# sudo — required by wash-priv for privilege escalation now that
# wash-router runs as the unprivileged `wash` user (see the users
# table below + the init script). Even with NOPASSWD policy we
# need the sudo binary present; priv's runSudo calls it.
BR2_PACKAGE_SUDO=y

# Users table: defines additional non-root accounts created at
# rootfs assembly time. We add a single `wash` user that
# wash-router drops to before exec, so the realistic "user shell
# clicks a launcher → priv mediates root operations" flow is
# exercised in the embedded VM (not just root-on-root passthrough).
# Format documented at
#   https://buildroot.org/downloads/manual/manual.html#makeuser-syntax
BR2_ROOTFS_USERS_TABLES="/input/users.table"

BR2_TARGET_GENERIC_HOSTNAME="wash"
BR2_TARGET_GENERIC_ISSUE="wash riscv64 (buildroot)"
# getty runs on /dev/hvc1 (the first virtio-console). TinyEMU's HTIF
# (hvc0) is output-only in the WASM build — keystrokes can't reach
# it, so a getty there would be useless. The wash demo's [shell]
# tab is connected via window.washConsoles[0] which corresponds to
# hvc1; user keystrokes flow in → getty reads them → login prompt.
BR2_TARGET_GENERIC_GETTY_PORT="hvc1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_PASSWD_METHOD="sha-256"

# Overlay path is the absolute path inside the build container.
# Dockerfile COPYs the staged overlay (wash binaries + init scripts)
# to this exact path so buildroot can rsync it onto target/ during
# the rootfs assembly step. Setting it here (in the defconfig) is
# essential — env overrides at `make` time are ignored once the
# defconfig has produced .config.
BR2_ROOTFS_OVERLAY="/overlay"

# squashfs (LZ4-compressed) is the on-wire rootfs format. Boot path:
# kernel → initramfs /init → mount squashfs ro on /mnt/ro + tmpfs
# upper + overlayfs → switch_root. Writes go to the tmpfs upper layer
# only, so /var/log etc. never touch the squashfs blob — page reload
# = fresh VM.
#
# Compression: LZ4 (not ZSTD or XZ). The emulated CPU inside the
# WASM-built TinyEMU is ~50× slower than a native host at decompression,
# so even though ZSTD packs ~10% tighter, LZ4 decompresses 8-10× faster
# under emulation and shows up as several seconds saved in cold-boot
# wall clock. Trade absolute bytes for emulated CPU cycles.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# Post-build hook: see image/rootfs/post-build.sh. Buildroot runs it
# with $1 = staged target/ dir, before mksquashfs packs it.
BR2_ROOTFS_POST_BUILD_SCRIPT="/input/post-build.sh"
# No ext2, no tarball, no other formats — we just want the squashfs.
# BR2_TARGET_ROOTFS_EXT2 is not set
