# Busybox config fragment — merged on top of buildroot's default
# busybox config. Enables the applets the wash demo expects (full net
# tooling, nano-style editors, a few diag helpers).

CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_SH_STANDALONE=y

# --- net applets ---
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_FEATURE_IP_RULE=y
CONFIG_FEATURE_IP_TUNNEL=y
CONFIG_FEATURE_IP_NEIGH=y
CONFIG_IPADDR=y
CONFIG_IPLINK=y
CONFIG_IPROUTE=y
CONFIG_IPRULE=y
CONFIG_IPTUNNEL=y
CONFIG_IPNEIGH=y
CONFIG_PING=y
CONFIG_PING6=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_NSLOOKUP=y
CONFIG_FEATURE_NSLOOKUP_BIG=y
CONFIG_FEATURE_NSLOOKUP_LONG_OPTIONS=y
CONFIG_TRACEROUTE=y
CONFIG_TRACEROUTE6=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_NETSTAT=y
CONFIG_FEATURE_NETSTAT_WIDE=y
CONFIG_FEATURE_NETSTAT_PRG=y
CONFIG_ROUTE=y
CONFIG_ARP=y
CONFIG_ARPING=y
CONFIG_IFCONFIG=y
CONFIG_IFUP=y
CONFIG_IFDOWN=y
CONFIG_HOSTNAME=y
CONFIG_HOSTID=y

# --- editors ---
CONFIG_VI=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=y
CONFIG_AWK=y
CONFIG_SED=y
CONFIG_DIFF=y
CONFIG_PATCH=y
CONFIG_LESS=y
CONFIG_MORE=y

# --- system diag ---
CONFIG_TOP=y
CONFIG_FEATURE_TOP_INTERACTIVE=y
CONFIG_FEATURE_TOPMEM=y
CONFIG_IOSTAT=y
CONFIG_VMSTAT=y
CONFIG_MPSTAT=y
CONFIG_POWERTOP=y
CONFIG_FUSER=y
CONFIG_LSOF=y
CONFIG_PSTREE=y
CONFIG_PMAP=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_LOADAVG=y
CONFIG_PIDOF=y
CONFIG_PIDOF_OMIT=y
CONFIG_PIDOF_SINGLE=y
CONFIG_KILLALL=y
CONFIG_KILLALL5=y

# --- file ops ---
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_GREP=y
CONFIG_TAR=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_UNZIP=y
CONFIG_TR=y
CONFIG_CUT=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_STAT=y
CONFIG_DU=y
CONFIG_FILE=y
CONFIG_REALPATH=y
CONFIG_READLINK=y
CONFIG_BASE64=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA512SUM=y

# --- net clients ---
CONFIG_WGET=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_TELNET=y
