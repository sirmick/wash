/out/
**/dist/
**/node_modules/
# Per-app FE bundles get copied into each app's package via the
# Makefile and embedded with //go:embed. Same convention now spans
# the standalone-shim assets (cmd/*/assets — historical) AND the
# extracted runtime packages (internal/apps/*/assets,
# internal/runner/*/assets). The vendor/ tree under web/shell/public
# is produced by build-vendor.mjs + the @wash/ui vite build.
cmd/*/assets/
internal/apps/*/assets/
internal/runner/*/assets/
apps/*/be/assets/
# The shared shell-runtime bundle (wash-router + wash-login embed it
# from one package) is staged here by $(SHELL_STAMP); build artifact.
internal/shellassets/assets/
web/shell/public/vendor/
e2e/test-results/
e2e/playwright-report/
# Stray dev binaries: `go build ./cmd/wash` without -o lands the
# binary at the repo root. Same for ./cmd/wash-router. They're never
# what you actually want in the tree.
/wash
/wash-router
# Out-of-tree build artifacts for the v86 demo + image builds —
# heavy (hundreds of MB) and produced by separate toolchains.
/image/
/image-rv/
/web/demo/

# /understand knowledge-graph tooling output (per-checkout, not source)
.understand-anything/

# wash-display CMake build dir
wash-display/build/
# Stray distro packages downloaded while probing system wlroots deps
# (e.g. libwlroots-dev_*.deb). The build links system wlroots via
# pkg-config; these downloads are never part of the tree.
wash-display/*.deb
# Vendored wlroots is committed as SOURCE; its Meson build output is not.
wash-display/third_party/wlroots/build/

# Vendored reference sources (mac-phoenix, greenfield) for the
# compositor work — heavy borrow, never committed.
tmp/

# Ad-hoc display-probe capture output (display-probe.cap.ts) — large,
# host-specific PNGs/logs for local inspection, never committed.
screenshots/
# …but the curated marketing shots under docs/screenshots/ ARE committed
# (generated deterministically by `make screenshots`, referenced from README).
!docs/screenshots/
!docs/screenshots/*.png

# Isolated git worktrees for parallel work (e.g. FE refactor) — each
# is its own branch checkout sharing this repo's objects/history.
branches/

# go test --coverage output (./test.sh --coverage)
coverage/

# Stray playwright run artifact when a suite is invoked from the repo
# root rather than e2e/ (the e2e/ one is already ignored above).
/test-results/

# Local-only net scratch: harbor.config is a raw RouterOS export of the
# author's home router used as a real-world reference while building the
# net app — it carries live credentials, so it stays out of the tree
# (any committed golden fixture must be a scrubbed copy). test-net.py is
# the external Proxmox segmentation script cmd/washnet-matrix is modeled
# on, kept here for reference only.
/harbor.config
/test-net.py

# Python bytecode (test guests)
__pycache__/
*.pyc

# Local dev-estate deploy notes (machine-specific; not part of the project)
/docs/DEPLOY-ESTATE.md

# Source/working imagery (wallpaper EPS/zips, screenshots, converted SVGs);
# kept locally, not committed — packs reference the embedded copies under
# web/shell/public/wallpapers/.
/imagery/
