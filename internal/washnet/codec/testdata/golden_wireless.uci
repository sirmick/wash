config wifi-device 'radio0'
	option type 'mac80211'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'US'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option mode 'ap'
	option ssid 'wash'
	option network 'lan'
	option encryption 'psk2'
	option key 'supersecret'
