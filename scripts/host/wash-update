#!/usr/bin/env bash
# wash-update — bring the host's checkout up to date and restart the
# router wash-start runs: fetch, fast-forward the branch, pnpm install,
# make wash, then wash-start. Refuses to touch a checkout with tracked
# local changes.
#
#   wash-update            fetch and fast-forward WASH_BRANCH from origin, then build and restart
#   wash-update --local    build and restart what is checked out now: no fetch, no checkout,
#                          no pull. For testing local commits before they are pushed.
#
# Environment (all optional):
#   WASH_REPO      repository to update (default: the checkout this script lives in)
#   WASH_BRANCH    branch to fast-forward             (default main; ignored with --local)
#   WASH_LISTEN    host:port passed on to wash-start  (default 0.0.0.0:10000)

set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
repo="${WASH_REPO:-$(cd "$here/../.." && pwd)}"
listen="${WASH_LISTEN:-0.0.0.0:10000}"
branch="${WASH_BRANCH:-main}"
local_only=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --local) local_only=1; shift;;
    -h|--help)
      sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//' | sed '$d'
      exit 0
      ;;
    *)
      printf 'wash-update: unknown flag: %s (use --help)\n' "$1" >&2
      exit 2
      ;;
  esac
done

if [[ ! -d "$repo/.git" && ! -f "$repo/.git" ]]; then
  printf 'wash-update: repository not found at %s\n' "$repo" >&2
  exit 1
fi

for command_name in git go node pnpm make; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'wash-update: required command not found: %s\n' "$command_name" >&2
    exit 1
  fi
done

cd "$repo"

# Uncommitted edits would be built into a router nobody can reproduce
# from a commit; local commits are fine (--local exists for them).
if ! git diff --quiet || ! git diff --cached --quiet; then
  printf 'wash-update: tracked local changes exist in %s; commit or stash them first\n' "$repo" >&2
  exit 1
fi

if [[ "$local_only" == "1" ]]; then
  printf 'Building wash in %s as checked out: %s\n' "$repo" "$(git log -1 --format='%h %s' HEAD)"
  if upstream="$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)"; then
    ahead="$(git rev-list --count "$upstream..HEAD")"
    [[ "$ahead" != "0" ]] && printf '(%s commit(s) ahead of %s, not pushed)\n' "$ahead" "$upstream"
  fi
else
  printf 'Updating wash in %s (branch %s)...\n' "$repo" "$branch"
  git fetch --tags origin
  git checkout "$branch"
  git pull --ff-only origin "$branch"
fi
pnpm install --frozen-lockfile
make wash

printf 'Restarting wash on %s...\n' "$listen"
exec env WASH_REPO="$repo" WASH_LISTEN="$listen" "$here/wash-start"
