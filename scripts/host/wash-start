#!/usr/bin/env bash
# wash-start — run the built router as a persistent, detached GNU Screen
# session with HTTPS and a token, so one machine serves wash to the LAN
# across logouts. Pair with wash-connect (prints the URL) and wash-update
# (pull, rebuild, restart).
#
# Environment (all optional):
#   WASH_REPO             repository with a built out/wash-router
#                         (default: the checkout this script lives in)
#   WASH_LISTEN           host:port to serve on       (default 0.0.0.0:10000)
#   WASH_SCREEN_SESSION   screen session name         (default wash)
#   WASH_SCREEN_LOG       router log                  (default ~/.local/state/wash/screen.log)
#   WASH_TOKEN_FILE       auth token the router mints (default ~/.local/state/wash/router.token)
#
# Install: make install-host-scripts   (symlinks into ~/.local/bin; HOST_BINDIR= to change)

set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
repo="${WASH_REPO:-$(cd "$here/../.." && pwd)}"
listen="${WASH_LISTEN:-0.0.0.0:10000}"
session="${WASH_SCREEN_SESSION:-wash}"
log="${WASH_SCREEN_LOG:-$HOME/.local/state/wash/screen.log}"
token_file="${WASH_TOKEN_FILE:-$HOME/.local/state/wash/router.token}"
router="$repo/out/wash-router"

if [[ ! -x "$router" ]]; then
  printf 'wash-start: router not found or not executable: %s (run make wash)\n' "$router" >&2
  exit 1
fi

if ! command -v screen >/dev/null 2>&1; then
  printf 'wash-start: GNU Screen is required\n' >&2
  exit 1
fi

mkdir -p "$(dirname "$log")" "$(dirname "$token_file")"
chmod 0700 "$(dirname "$token_file")"

# Replacing the named session also terminates the router and its child apps.
screen -S "$session" -X quit >/dev/null 2>&1 || true
screen -dmS "$session" -L -Logfile "$log" \
  "$router" --listen "$listen" --auth-token-file "$token_file"

# The session appears as soon as screen forks, so seeing it once proves
# nothing; a router that dies on startup (port taken, bad flag) takes the
# session with it within a second or two. Require it to still be there.
up=0
for _ in $(seq 1 30); do
  if screen -S "$session" -Q select . >/dev/null 2>&1; then
    up=$((up + 1))
    if (( up >= 15 )); then
      printf 'wash-start: screen session %s is running with HTTPS on %s\n' "$session" "$listen"
      exit 0
    fi
  else
    up=0
  fi
  sleep 0.1
done

printf 'wash-start: screen session %s failed to stay running; see %s\n' "$session" "$log" >&2
exit 1
