#!/bin/sh
# wash-login postrm.
#
# This package owns the wash-system user, wash group, and /etc/wash, so it is
# responsible for tearing them down. On purge only: remove them. On remove
# (non-purge) we leave them in place so a reinstall is seamless.

set -e

case "$1" in
    purge)
        # NB: service enable-symlink teardown is handled by the
        # dh_installsystemd-generated snippet appended below. Do NOT write the
        # literal debhelper token in a comment: dh_installdeb substitutes it
        # wherever it appears, which would splice the snippet mid-comment.
        if getent passwd wash-system >/dev/null; then
            deluser --quiet --system wash-system >/dev/null 2>&1 || true
        fi
        if getent group wash >/dev/null; then
            delgroup --quiet --system wash >/dev/null 2>&1 || true
        fi
        rm -rf /etc/wash
        rm -rf /var/lib/wash
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
