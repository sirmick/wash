#!/usr/bin/make -f
# By the time dpkg-buildpackage runs, the wash-* binaries already exist
# under out/ — compiled in the sanitized build container (packaging/
# Dockerfile.binaries) and shipped inside this source tarball. debhelper's
# auto_build / auto_test / strip / dwz steps are therefore all no-ops:
#   - nothing left to compile
#   - tests ran in the build container before the tarball was assembled
#   - binaries are already stripped via -ldflags="-s -w"
#   - static Go binaries have no DWARF dh_dwz can process

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_clean:
# Default would invoke `make clean`, which wipes out/ — exactly the
# dir holding our prebuilt binaries. No-op so dh_install can see them.
override_dh_auto_build:
override_dh_auto_test:
override_dh_strip:
override_dh_dwz:

# Install the wash package's binaries from the single source-of-truth list
# (packaging/wash.binaries, generated from the Makefile's BINS). This replaces
# a hand-maintained debian/wash.install so a new app ships automatically — the
# drift that left net/media/vscode out of 0.9.0 can't recur. dh_install still
# runs afterward to process the optional wash-display package's own .install.
override_dh_install:
	# Core `wash` package: every binary from the single-source inventory EXCEPT
	# wash-login, which ships in its own package. packaging/wash.binaries stays
	# the full list (CI drift-guard vs the Makefile's BINS), so filter it here.
	install -d debian/wash/usr/bin
	while read -r b; do \
	  [ -n "$$b" ] || continue; \
	  [ "$$b" = wash-login ] && continue; \
	  install -m0755 out/$$b debian/wash/usr/bin/$$b; \
	done < packaging/wash.binaries
	# `wash-login` package: the front-door binary + its systemd unit
	# (single-source packaging/wash-login.service, shared verbatim with the rpm)
	# + its EnvironmentFile. The default dh_installsystemd step finds the staged
	# unit and appends enable/start snippets to debian/wash-login.postinst at the
	# #DEBHELPER# marker. NB: never write the literal debhelper token in a
	# maintscript comment — dh_installdeb substitutes it wherever it appears,
	# splicing the snippet mid-comment (a dash syntax error at install time).
	install -D -m0755 out/wash-login debian/wash-login/usr/bin/wash-login
	install -D -m0644 packaging/wash-login.service debian/wash-login/usr/lib/systemd/system/wash-login.service
	install -D -m0644 packaging/wash-login.default debian/wash-login/etc/default/wash-login
	dh_install

# Neither package PROVIDES a shared library — they ship executables only —
# so dh_makeshlibs has nothing to generate. Skip it: on a cross build it
# would otherwise shell out to <arch>-linux-gnu-objdump (cross binutils we
# don't install), breaking the arm64/riscv64 rows.
override_dh_makeshlibs:

# The pure-Go `wash` package is fully static → no shared-library deps to
# compute (and dh_shlibdeps would just churn). The optional wash-display
# package, by contrast, links wlroots/wayland/webp dynamically, so it DOES
# need ${shlibs:Depends} filled in — but only when its build profile is
# active. Run dh_shlibdeps for that package alone, when it's being built.
override_dh_shlibdeps:
ifneq (,$(filter pkg.wash.display,$(DEB_BUILD_PROFILES)))
	# wash-display links the bundled, private libwlroots.so under /usr/lib/wash
	# (rpath). Point dpkg-shlibdeps at that staged dir with -l so it resolves
	# libwlroots internally (no external pkg) while still computing the real
	# deps for wlroots' OWN needs (wayland-server, libdrm, pixman, xkbcommon,
	# xcb*, xwayland) from the system shlibs.
	dh_shlibdeps -p wash-display -- -l$(CURDIR)/debian/wash-display/usr/lib/wash
endif
