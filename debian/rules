#!/usr/bin/make -f
# By the time dpkg-buildpackage runs, the wash-* binaries already exist
# under out/ — compiled in the sanitized build container (packaging/
# Dockerfile.binaries) and shipped inside this source tarball. debhelper's
# auto_build / auto_test / strip / dwz steps are therefore all no-ops:
#   - nothing left to compile
#   - tests ran in the build container before the tarball was assembled
#   - binaries are already stripped via -ldflags="-s -w"
#   - static Go binaries have no DWARF dh_dwz can process

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_clean:
# Default would invoke `make clean`, which wipes out/ — exactly the
# dir holding our prebuilt binaries. No-op so dh_install can see them.
override_dh_auto_build:
override_dh_auto_test:
override_dh_strip:
override_dh_dwz:

# Install the wash package's binaries from the single source-of-truth list
# (packaging/wash.binaries, generated from the Makefile's BINS). This replaces
# a hand-maintained debian/wash.install so a new app ships automatically — the
# drift that left net/media/vscode out of 0.9.0 can't recur. dh_install still
# runs afterward to process the optional wash-display package's own .install.
override_dh_install:
	# Core `wash` package: the multicall dispatcher (out/wash) holds the Go
	# runtime + SDK + crypto/tls ONCE; every wash-<app> is a RELATIVE symlink to
	# it (lintian wants relative symlinks within /usr/bin). packaging/wash.binaries
	# is the canonical name list (CI drift-guard vs the Makefile's BINS). Two names
	# are NOT symlinks: wash-login ships in its own package (its file-caps must not
	# be shared) and wash-sudo is a real standalone helper (not in the multicall).
	install -D -m0755 out/wash       debian/wash/usr/bin/wash
	install -D -m0755 out/wash-sudo  debian/wash/usr/bin/wash-sudo
	while read -r b; do \
	  [ -n "$$b" ] || continue; \
	  case "$$b" in wash-login|wash-sudo|wash-display) continue ;; esac; \
	  ln -sf wash debian/wash/usr/bin/$$b; \
	done < packaging/wash.binaries
	# `wash-login` package: a REAL standalone binary (cap_setuid/setgid/kill are
	# per-inode, so it can't share the multicall) + its systemd unit
	# (single-source packaging/wash-login.service) + EnvironmentFile. The default
	# dh_installsystemd step finds the staged unit and appends enable/start
	# snippets to debian/wash-login.postinst at the #DEBHELPER# marker. NB: never
	# write the literal debhelper token in a maintscript comment — dh_installdeb
	# substitutes it wherever it appears, splicing the snippet mid-comment.
	install -D -m0755 out/wash-login debian/wash-login/usr/bin/wash-login
	install -D -m0644 packaging/wash-login.service debian/wash-login/usr/lib/systemd/system/wash-login.service
	install -D -m0644 packaging/wash-login.default debian/wash-login/etc/default/wash-login
	# Example supervisord program for no-systemd/container hosts. Docs only —
	# shipped under /usr/share/wash-login/, never activated by the package.
	install -D -m0644 packaging/wash-login.supervisord.conf debian/wash-login/usr/share/wash-login/supervisord.conf
	# Man pages: one source (packaging/wash.1) + a .so redirect stub per applet
	# so every /usr/bin entry has a man page (lintian binary-without-manpage).
	# Stubs generated from wash.binaries; wash-login's lives in its own package.
	install -D -m0644 packaging/wash.1 debian/wash/usr/share/man/man1/wash.1
	while read -r b; do \
	  [ -n "$$b" ] || continue; \
	  case "$$b" in wash-login|wash-display) continue ;; esac; \
	  echo '.so man1/wash.1' > debian/wash/usr/share/man/man1/$$b.1; \
	  chmod 0644 debian/wash/usr/share/man/man1/$$b.1; \
	done < packaging/wash.binaries
	install -d debian/wash-login/usr/share/man/man1
	echo '.so man1/wash.1' > debian/wash-login/usr/share/man/man1/wash-login.1
	chmod 0644 debian/wash-login/usr/share/man/man1/wash-login.1
	# Bash completion for the multicall dispatcher.
	install -D -m0644 packaging/wash.bash debian/wash/usr/share/bash-completion/completions/wash
	dh_install

# Neither package PROVIDES a shared library — they ship executables only —
# so dh_makeshlibs has nothing to generate. Skip it: on a cross build it
# would otherwise shell out to <arch>-linux-gnu-objdump (cross binutils we
# don't install), breaking the arm64/riscv64 rows.
override_dh_makeshlibs:

# The pure-Go `wash` package is fully static → no shared-library deps to
# compute (and dh_shlibdeps would just churn). The optional wash-display
# package, by contrast, links wlroots/wayland/webp dynamically, so it DOES
# need ${shlibs:Depends} filled in — but only when its build profile is
# active. Run dh_shlibdeps for that package alone, when it's being built.
override_dh_shlibdeps:
ifneq (,$(filter pkg.wash.display,$(DEB_BUILD_PROFILES)))
	# wash-display links the bundled, private libwlroots.so under /usr/lib/wash
	# (rpath). Point dpkg-shlibdeps at that staged dir with -l so it resolves
	# libwlroots internally (no external pkg) while still computing the real
	# deps for wlroots' OWN needs (wayland-server, libdrm, pixman, xkbcommon,
	# xcb*, xwayland) from the system shlibs.
	dh_shlibdeps -p wash-display -- -l$(CURDIR)/debian/wash-display/usr/lib/wash
endif
