# Maintainer: wash maintainers <wash@example.invalid>
pkgname=wash
pkgver=0.8.0
pkgrel=1
pkgdesc="Lightweight remote-admin desktop environment"
url="https://github.com/sirmick/wash"
arch="x86_64"
license="MIT"
depends="libcap shadow"
# No makedepends: binaries are prebuilt in the source tarball.
options="!check !strip"
install="$pkgname.pre-install $pkgname.post-install $pkgname.post-deinstall"
source="wash_$pkgver.tar.xz"
# pre-built binaries; no upstream sha to verify
builddir="$srcdir/wash-$pkgver"

build() {
    # Nothing to build — wash ships prebuilt static binaries.
    :
}

package() {
    cd "$builddir"
    install -d "$pkgdir/usr/bin"
    for bin in wash-router wash-login wash-session wash-about wash-fm wash-term \
               wash-edit wash-bulk wash-priv wash-journal wash-notify \
               wash-settings wash-top wash-syslogs wash-services wash-packages \
               wash-launch wash-sudo; do
        install -m 0755 out/$bin "$pkgdir/usr/bin/$bin"
    done
    install -d -m 0755 "$pkgdir/etc/wash"
}
