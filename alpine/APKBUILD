# Maintainer: sirmick <sirmick@gmail.com>
pkgname=wash
pkgver=0.9.6
pkgrel=1
pkgdesc="Lightweight remote-admin desktop environment"
url="https://github.com/sirmick/wash"
arch="x86_64 aarch64 riscv64"
license="AGPL-3.0-or-later"
# Core wash is just the router + apps; it creates no user and needs no caps, so
# it carries no depends (the multi-user deps live on the wash-login subpackage).
depends=""
# No makedepends: binaries are prebuilt in the source tarball.
options="!check !strip"
# All install scripts across the main package AND subpackages must be listed
# here — abuild does NOT auto-detect them; it routes each "<name>.<action>" to
# the (sub)package whose name matches the prefix. So wash.post-install attaches
# to the core package and the wash-login.* scripts attach to the wash-login
# subpackage (user creation, caps, service enable, teardown).
install="$pkgname.post-install
	$pkgname-login.pre-install
	$pkgname-login.post-install
	$pkgname-login.post-deinstall"
# wash-login subpackage: the multi-user front door, always built. Its split
# function (_login) is below; abuild attaches alpine/wash-login.{pre,post}-install
# and wash-login.post-deinstall to it by name.
subpackages="$pkgname-login:_login"
# Optional native display subpackage. Declared ONLY when the build
# container produced out/wash-display (WASH_DISPLAY=1) — abuild's
# prepare_subpackages runs for EVERY entry listed here regardless of what
# the split function returns, so a declared-but-empty subpackage aborts the
# build ("Missing .../pkg/wash-display"). The Dockerfile.apk flow always
# sets WASH_DISPLAY to 0 or 1, so test for "1" explicitly (a bare -n check
# would fire on "0"). Mirrors deb's `pkg.wash.display` build profile and
# rpm's `%bcond_with display`.
if [ "${WASH_DISPLAY:-0}" = "1" ]; then
	subpackages="$subpackages $pkgname-display:_display"
fi
source="wash_$pkgver.tar.xz"
# pre-built binaries; no upstream sha to verify
builddir="$srcdir/wash-$pkgver"

build() {
    # Nothing to build — wash ships prebuilt static binaries.
    :
}

package() {
    cd "$builddir"
    install -d "$pkgdir/usr/bin"
    # Multicall layout: the dispatcher (out/wash) once + a relative symlink per
    # wash-<app> from the canonical name list (packaging/wash.binaries, the CI
    # drift-guard vs BINS). wash-sudo is a real standalone helper; wash-login is
    # the subpackage (file-caps can't be shared); wash-display is the cgo subpackage.
    install -m 0755 out/wash      "$pkgdir/usr/bin/wash"
    install -m 0755 out/wash-sudo "$pkgdir/usr/bin/wash-sudo"
    while read -r bin; do
        [ -n "$bin" ] || continue
        case "$bin" in wash-login|wash-sudo|wash-display) continue ;; esac
        ln -sf wash "$pkgdir/usr/bin/$bin"
    done < packaging/wash.binaries
    # Man pages: source wash.1 + a .so redirect stub per applet (mandoc resolves
    # .so). Bash completion for the dispatcher.
    install -Dm0644 packaging/wash.1 "$pkgdir/usr/share/man/man1/wash.1"
    while read -r bin; do
        [ -n "$bin" ] || continue
        case "$bin" in wash-login|wash-display) continue ;; esac
        echo ".so man1/wash.1" > "$pkgdir/usr/share/man/man1/$bin.1"
    done < packaging/wash.binaries
    # abuild requires man pages be gzip-compressed (deb/rpm do this automatically).
    gzip -9n "$pkgdir/usr/share/man/man1/"*.1
    install -Dm0644 packaging/wash.bash "$pkgdir/usr/share/bash-completion/completions/wash"
}

_login() {
    pkgdesc="Multi-user login front door for wash"
    depends="wash=$pkgver-r$pkgrel libcap shadow"
    # Not pulled in automatically — installing wash-login is an explicit choice.
    install_if=""
    cd "$builddir"
    # The front-door binary, its OpenRC service (Alpine's init-system parity with
    # the systemd unit on deb/rpm), and the env file (same single-source
    # packaging/wash-login.default, installed as the OpenRC confd). /etc/wash is
    # NOT shipped in the package: apk would record it root:root (fakeroot can't
    # chown to the not-yet-created wash-system user) and then reset that owner
    # after post-install. Instead wash-login.post-install creates it owned
    # wash-system:wash, and post-deinstall removes it (matches the deb).
    install -Dm0755 out/wash-login "$subpkgdir/usr/bin/wash-login"
    install -Dm0755 alpine/wash-login.initd "$subpkgdir/etc/init.d/wash-login"
    install -Dm0644 packaging/wash-login.default "$subpkgdir/etc/conf.d/wash-login"
    # Example supervisord program for no-systemd/container hosts (docs only).
    install -Dm0644 packaging/wash-login.supervisord.conf "$subpkgdir/usr/share/wash-login/supervisord.conf"
    # Man stub (.so → wash.1 from the wash package; depends=wash). gzip: abuild
    # rejects uncompressed man pages.
    mkdir -p "$subpkgdir/usr/share/man/man1"
    echo ".so man1/wash.1" > "$subpkgdir/usr/share/man/man1/wash-login.1"
    gzip -9n "$subpkgdir/usr/share/man/man1/wash-login.1"
}

_display() {
    pkgdesc="Native X/Wayland app surfaces for wash"
    depends="wash=$pkgver-r$pkgrel xwayland"
    if [ ! -f "$builddir/out/wash-display" ]; then
        msg "wash-display not built (WASH_DISPLAY=1); skipping subpackage"
        return 0
    fi
    install -Dm0755 "$builddir/out/wash-display" "$subpkgdir/usr/bin/wash-display"
}
