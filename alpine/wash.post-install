#!/bin/sh
# wash (core) post-install. The core package ships only the router + app
# binaries and runs as the invoking user, so it creates no user and needs no
# capabilities (that lives in the wash-login subpackage). The one thing core
# must do is satisfy wash-priv's trust gate: the router's registry refuses
# reservedID com.wash.priv from non-root binaries unless mode 0755 root:root.

set -e

# wash-priv is a symlink to the multicall binary; the trust check stat()s
# through it, so the anchor that must be root:root 0755 is /usr/bin/wash.
if [ -e /usr/bin/wash ]; then
    chown root:root /usr/bin/wash
    chmod 0755 /usr/bin/wash
fi
exit 0
